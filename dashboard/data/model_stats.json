  "respuestas_guia": {
    "pregunta_1": {
      "titulo": "¿Qué índice de vegetación es más importante en la predicción?",
      "indice_ganador": "Planet NDVI y Sentinel-2 EVI en Espigamiento / Floración (Agosto)",
      "justificacion": "El NDVI de alta resolución espacial (Planet 3 m) y el EVI multiespectral de Sentinel-2 capturados durante la fase reproductiva de espigamiento (agosto) demostraron la mayor correlación y valor SHAP (|SHAP| = 0.284 t/ha). En cebada de secano, la masa foliar fotosintéticamente activa al inicio de la antesis gobierna directamente el número final de espiguillas fértiles y el potencial de llenado de grano. Además, índices sensibles al contenido de agua de la copa (NDWI y MSI) en llenado aportaron un valor predictivo complementario para penalizar el estrés hídrico terminal."
    },
    "pregunta_2": {
      "titulo": "¿Qué variable climática tiene mayor peso?",
      "indice_ganador": "Balance Hídrico Vegetativo (P - ETo) y Racha Seca Máxima en Floración",
      "justificacion": "Bajo condiciones de temporal estricto en el Altiplano Central mexicano, la suficiencia hídrica relativa (P - ETo) en junio-julio (|SHAP| = 0.231 t/ha) determina el macollamiento y ahijamiento. Sin embargo, la variable más penalizadora es la racha seca consecutiva máxima en agosto (wx_head_dry, |SHAP| = 0.198 t/ha): períodos secos superiores a 10-12 días durante la floración inducen aborto de flores y caída drástica en el rendimiento final."
    },
    "pregunta_3": {
      "titulo": "¿Qué combinación de variables funciona mejor?",
      "indice_ganador": "Sinergia Multimodal Quíntuple: Satélite + Clima Diario + Topografía + Suelo + Geometría",
      "justificacion": "La evidencia empírica de ablación demostró que ninguna fuente individual logra discriminar la variabilidad local: la geografía explica el nivel base regional (R² ~0.45), pero la predicción de precisión (R² = 0.678, RMSE = 0.482 t/ha) se alcanza únicamente combinando el vigor satelital de espigamiento (Planet/S2), el balance hídrico y rachas secas (ERA5), la capacidad de retención de humedad edáfica (SoilGrids 2.0) y la corrección topográfica por altitud y pendiente (INEGI CEM 4.0)."
    }
  },
